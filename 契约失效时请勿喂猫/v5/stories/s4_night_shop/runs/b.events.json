墨水字的）；库存（墙角立着的几箱水，外面裹着塑料膜）；送货（一箱刚搬下来的水，箱底沾着灰）；夜间补货（一箱还没拆封的酸奶，箱口压着送货单）；清晨补货（一箱刚卸下的面包，塑料袋上结着水汽）；夜间记录（后仓墙上挂着的一本横格簿，绳子拴着笔；手写的，用的是钢笔）；巡夜登记（收银台边上摊着的一张登记表，格子里等人签到；印上去的）。"}, {"op": "clock", "to": 1652}], "id": 47, "kind": "intent", "note": {"digest_after": "952680721e5549de00e64b41ad084a5e02b1c4d9f7704eb0b0bec115593ea362", "target": "patrol_log"}, "what": "examine"}, {"actor": null, "at": 1770, "atoms": [{"op": "clock", "to": 1770}], "id": 48, "kind": "tick", "note": {"digest_after": "05bb26b2ca08e45b673769552a80cb485ae9983095155533d42563a2b61a2a1a"}, "what": "clock"}, {"actor": null, "at": 1770, "atoms": [{"at": 1770, "op": "unschedule", "seq": 4}, {"e": "morning_crate", "op": "move", "to": "back_room"}, {"at": 1770, "e": "incoming", "op": "remember", "v": "送货车在后仓门口停下，卸下清晨补货。"}], "id": 49, "kind": "world", "note": {"digest_after": "316c4eb39c89bd059d58e808b692b5dadefd3434ef394a868e73098b8c91a76e", "effect": {"item": "morning_crate", "kind": "deliver", "place": "back_room"}}, "what": "deliver"}, {"actor": "incoming", "at": 1770, "atoms": [{"e": "incoming", "op": "move", "to": "back_room"}, {"at": 1770, "e": "incoming", "op": "remember", "v": "你到了后仓。"}, {"at": 1770, "e": "outgoing", "op": "remember", "v": "接班者走了进来。"}, {"at": 1770, "e": "customer", "op": "remember", "v": "接班者走了进来。"}, {"at": 1770, "e": "driver", "op": "remember", "v": "接班者走了进来。"}, {"at": 1770, "e": "patrol", "op": "remember", "v": "那个人走了进来。"}, {"op": "clock", "to": 1772}], "id": 50, "kind": "intent", "note": {"digest_after": "ba52b103ef23e2cac7825391b2da3ee8dc005354cbdd2fda608e3a49819ab57a", "target": "back_room"}, "what": "move"}, {"actor": "incoming", "at": 1772, "atoms": [{"at": 1772, "e": "incoming", "op": "remember", "v": "你数了清晨补货：共 4（清晨补货 4）。"}, {"op": "clock", "to": 1773}], "id": 51, "kind": "intent", "note": {"digest_after": "3a121b0afa210a7ada3ee113b8bfb3b4a842a320a324b2a2d96f077d1e154708", "target": "morning_crate"}, "what": "count"}, {"actor": "incoming", "at": 1773, "atoms": [{"e": "incoming", "op"