；巡夜登记（收银台边上摊着的一张登记表，格子里等人签到；印上去的）。"}, {"op": "clock", "to": 1652}], "id": 49, "kind": "intent", "note": {"digest_after": "ef38dcabd67c4d3051943510f630108d5c1712ba527c493694d6f48f7708ed12", "target": "patrol_log"}, "what": "examine"}, {"actor": null, "at": 1770, "atoms": [{"op": "clock", "to": 1770}], "id": 50, "kind": "tick", "note": {"digest_after": "e7202cb9f24715852810f56ee7874e8f5924b4ff4ae5f8f5bf3e3d86c7fbd44d"}, "what": "clock"}, {"actor": null, "at": 1770, "atoms": [{"at": 1770, "op": "unschedule", "seq": 4}, {"e": "morning_crate", "op": "move", "to": "back_room"}, {"at": 1770, "e": "incoming", "op": "remember", "v": "送货车在后仓门口停下，卸下清晨补货。"}], "id": 51, "kind": "world", "note": {"digest_after": "45c97bfc24c08c0174e43d0f9476fe2c5660c6a78d32eb91aec5fe0969473106", "effect": {"item": "morning_crate", "kind": "deliver", "place": "back_room"}}, "what": "deliver"}, {"actor": "incoming", "at": 1770, "atoms": [{"e": "incoming", "op": "move", "to": "back_room"}, {"at": 1770, "e": "incoming", "op": "remember", "v": "你到了后仓。"}, {"at": 1770, "e": "outgoing", "op": "remember", "v": "接班者走了进来。"}, {"at": 1770, "e": "customer", "op": "remember", "v": "接班者走了进来。"}, {"at": 1770, "e": "driver", "op": "remember", "v": "接班者走了进来。"}, {"at": 1770, "e": "patrol", "op": "remember", "v": "那个人走了进来。"}, {"op": "clock", "to": 1772}], "id": 52, "kind": "intent", "note": {"digest_after": "63dda48e0a82b9f5078b64bb9500596b57eed93bf2d034d87fe8592a28823236", "target": "back_room"}, "what": "move"}, {"actor": "incoming", "at": 1772, "atoms": [{"at": 1772, "e": "incoming", "op": "remember", "v": "你数了清晨补货：共 4（清晨补货 4）。"}, {"op": "clock", "to": 1773}], "id": 53, "kind": "intent", "note": {"digest_after": "856d8399e462cb41e403d8e3aad314e7d2cac8cadbfe366528388d877e22082a", "target": "morning_crate"}, "what": "count"}, {"actor": "incoming", "at": 1773, "atoms": [{"e": "incoming", "op": "move", "to": "shop"}, {"at": 1773, "e": "incoming", "op": "remember", "v": "你到了店内。"}, {"at": 1773, "e": "outgoing", "op": "re